# ══════════════════════════════════════════════════════════════
# SAGALA SERVICE - Environment Configuration
# ══════════════════════════════════════════════════════════════

# Supabase Project URL & Anonymous Key (from your Supabase project dashboard -> Settings -> API)
# Note: If left empty or unconfigured, SAGALA SERVICE automatically runs in Demo/Prototype Mode
# with rich pre-loaded Madurai shops, real-time mock data, and full offline functionality!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
